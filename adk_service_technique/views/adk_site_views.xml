<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_adk_site_list" model="ir.ui.view">
        <field name="name">adk.site.list</field>
        <field name="model">adk.site</field>
        <field name="arch" type="xml">
            <list string="Points de contrôle" sample="1">
                <field name="name"/>
                <field name="code"/>
                <field name="partner_id"/>
                <field name="bloc_count"/>
                <field name="equipment_count"/>
                <field name="maintenance_open_count" decoration-warning="maintenance_open_count &gt; 0"/>
            </list>
        </field>
    </record>

    <record id="view_adk_site_kanban" model="ir.ui.view">
        <field name="name">adk.site.kanban</field>
        <field name="model">adk.site</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1">
                <field name="name"/>
                <field name="bloc_count"/>
                <field name="equipment_count"/>
                <field name="maintenance_open_count"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click p-2">
                            <div class="d-flex justify-content-between align-items-start">
                                <strong class="o_kanban_record_title"><field name="name"/></strong>
                                <span t-if="record.maintenance_open_count.raw_value" class="badge text-bg-warning">
                                    <t t-esc="record.maintenance_open_count.raw_value"/> en cours
                                </span>
                            </div>
                            <div class="text-muted mt-1">
                                <span><i class="fa fa-cubes me-1"/><t t-esc="record.bloc_count.raw_value"/> blocs</span>
                                <span class="ms-3"><i class="fa fa-wrench me-1"/><t t-esc="record.equipment_count.raw_value"/> équipements</span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_adk_site_form" model="ir.ui.view">
        <field name="name">adk.site.form</field>
        <field name="model">adk.site</field>
        <field name="arch" type="xml">
            <form string="Point de contrôle">
                <sheet>
                    <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_1920'}"/>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_view_blocs" icon="fa-cubes">
                            <field name="bloc_count" widget="statinfo" string="Blocs"/>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_view_equipments" icon="fa-wrench">
                            <field name="equipment_count" widget="statinfo" string="Équipements"/>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_view_maintenances" icon="fa-clipboard">
                            <field name="maintenance_count" widget="statinfo" string="Interventions"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Ex: Étage 1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="address"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Blocs">
                            <field name="bloc_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="description"/>
                                </list>
                            </field>
                        </page>
                        <page string="Équipements">
                            <field name="equipment_ids" context="{'default_site_ids': [id]}">
                                <list>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="bloc_ids" widget="many2many_tags"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'good'"
                                           decoration-danger="state == 'issue'"
                                           decoration-warning="state == 'maintenance'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_adk_site_search" model="ir.ui.view">
        <field name="name">adk.site.search</field>
        <field name="model">adk.site</field>
        <field name="arch" type="xml">
            <search string="Rechercher un point de contrôle">
                <field name="name"/>
                <field name="code"/>
                <field name="partner_id"/>
                <filter string="Archivés" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Regrouper par">
                    <filter string="Client / Responsable" name="group_partner" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_adk_site" model="ir.actions.act_window">
        <field name="name">Points de contrôle</field>
        <field name="res_model">adk.site</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_adk_site_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Créez votre premier point de contrôle</p>
            <p>Un point de contrôle représente un site ou un emplacement (Étage 1, Siège, Agence...).</p>
        </field>
    </record>

</odoo>
