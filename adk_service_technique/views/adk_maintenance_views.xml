<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_adk_maintenance_kanban" model="ir.ui.view">
        <field name="name">adk.maintenance.kanban</field>
        <field name="model">adk.maintenance</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column" sample="1">
                <field name="name"/>
                <field name="site_id"/>
                <field name="bloc_id"/>
                <field name="maintenance_type_id"/>
                <field name="state"/>
                <field name="priority"/>
                <field name="detection_date"/>
                <field name="equipment_id"/>
                <field name="team_id"/>
                <field name="agent_ids"/>
                <field name="color"/>
                <progressbar field="state" colors='{"draft": "muted", "in_progress": "warning", "done": "success", "cancel": "danger"}'/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_global_click p-2 #{record.priority.raw_value == '1' ? 'border-start border-danger border-3' : ''}">
                            <div class="d-flex justify-content-between">
                                <strong><field name="name"/></strong>
                                <span class="badge text-bg-light"><field name="maintenance_type_id"/></span>
                            </div>
                            <div class="text-muted small mt-1">
                                <i class="fa fa-map-marker me-1"/><field name="site_id"/>
                                <t t-if="record.bloc_id.raw_value"> / <field name="bloc_id"/></t>
                            </div>
                            <div class="text-muted small" t-if="record.equipment_id.raw_value">
                                <i class="fa fa-wrench me-1"/><field name="equipment_id"/>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <span class="text-muted small"><field name="detection_date" widget="date"/></span>
                                <field name="agent_ids" widget="many2many_avatar_employee"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_adk_maintenance_list" model="ir.ui.view">
        <field name="name">adk.maintenance.list</field>
        <field name="model">adk.maintenance</field>
        <field name="arch" type="xml">
            <list string="Interventions" sample="1" decoration-danger="priority == '1' and state != 'done'"
                  decoration-muted="state == 'cancel'">
                <field name="name"/>
                <field name="detection_date"/>
                <field name="maintenance_type_id"/>
                <field name="site_id"/>
                <field name="bloc_id" optional="hide"/>
                <field name="equipment_id" optional="hide"/>
                <field name="team_id" optional="show"/>
                <field name="duration" widget="float_time" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-warning="state == 'in_progress'"
                       decoration-danger="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <record id="view_adk_maintenance_calendar" model="ir.ui.view">
        <field name="name">adk.maintenance.calendar</field>
        <field name="model">adk.maintenance</field>
        <field name="arch" type="xml">
            <calendar date_start="detection_date" string="Interventions" color="maintenance_type_id" mode="month">
                <field name="site_id"/>
                <field name="maintenance_type_id"/>
            </calendar>
        </field>
    </record>

    <record id="view_adk_maintenance_form" model="ir.ui.view">
        <field name="name">adk.maintenance.form</field>
        <field name="model">adk.maintenance</field>
        <field name="arch" type="xml">
            <form string="Intervention de maintenance">
                <header>
                    <button name="action_start" type="object" string="Démarrer"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_done" type="object" string="Marquer bon fonctionnement"
                            class="btn-primary" invisible="state != 'in_progress'"/>
                    <button name="action_reset_draft" type="object" string="Réinitialiser"
                            invisible="state not in ('in_progress', 'done', 'cancel')"/>
                    <button name="action_cancel" type="object" string="Annuler"
                            invisible="state in ('done', 'cancel')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,done"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Urgente" bg_color="text-bg-danger" invisible="priority != '1'"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Localisation">
                            <field name="site_id"/>
                            <field name="bloc_id" domain="[('site_id', '=', site_id)]"/>
                            <field name="equipment_id" domain="[('site_ids', 'in', site_id)]"
                                   placeholder="Si l'anomalie concerne un équipement"/>
                            <field name="partner_id"/>
                        </group>
                        <group string="Classification">
                            <field name="maintenance_type_id"/>
                            <field name="detection_date"/>
                            <field name="priority" widget="priority"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Équipe d'intervention">
                        <field name="intervention_mode" widget="radio" options="{'horizontal': true}"/>
                        <field name="team_id" invisible="intervention_mode != 'team'"
                               required="intervention_mode == 'team'"/>
                        <field name="agent_ids" widget="many2many_tags" options="{'no_create': True}"
                               invisible="intervention_mode != 'agent'"
                               required="intervention_mode == 'agent'"/>
                    </group>
                    <group>
                        <group>
                            <field name="start_datetime"/>
                        </group>
                        <group>
                            <field name="end_datetime"/>
                            <field name="duration" widget="float_time" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Diagnostic">
                            <field name="diagnostic" placeholder="Décrire l'anomalie constatée..."/>
                        </page>
                        <page string="Mesures prises">
                            <field name="measures_taken" placeholder="Mesures déjà mises en œuvre..."/>
                        </page>
                        <page string="Actions à mener">
                            <field name="corrective_actions" placeholder="Mesures correctives / actions à mener..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_adk_maintenance_search" model="ir.ui.view">
        <field name="name">adk.maintenance.search</field>
        <field name="model">adk.maintenance</field>
        <field name="arch" type="xml">
            <search string="Rechercher une intervention">
                <field name="name"/>
                <field name="site_id"/>
                <field name="bloc_id"/>
                <field name="equipment_id"/>
                <field name="maintenance_type_id"/>
                <field name="team_id"/>
                <field name="agent_ids"/>
                <filter string="Mes interventions" name="my"
                        domain="[('agent_ids.user_id', '=', uid)]"/>
                <filter string="Brouillon" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="En cours" name="in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Terminées" name="done" domain="[('state', '=', 'done')]"/>
                <filter string="Urgentes" name="urgent" domain="[('priority', '=', '1')]"/>
                <separator/>
                <filter string="Date de constat" name="detection_date" date="detection_date"/>
                <group expand="0" string="Regrouper par">
                    <filter string="Point de contrôle" name="group_site" context="{'group_by': 'site_id'}"/>
                    <filter string="Bloc" name="group_bloc" context="{'group_by': 'bloc_id'}"/>
                    <filter string="Type de maintenance" name="group_type" context="{'group_by': 'maintenance_type_id'}"/>
                    <filter string="Équipe" name="group_team" context="{'group_by': 'team_id'}"/>
                    <filter string="Statut" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_adk_maintenance" model="ir.actions.act_window">
        <field name="name">Maintenances</field>
        <field name="res_model">adk.maintenance</field>
        <field name="view_mode">kanban,list,form,calendar</field>
        <field name="search_view_id" ref="view_adk_maintenance_search"/>
        <field name="context">{'search_default_in_progress': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Enregistrez votre première intervention</p>
            <p>Constat d'anomalie, diagnostic, mesures prises, actions correctives et statut.</p>
        </field>
    </record>

</odoo>
