<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_adk_equipment_list" model="ir.ui.view">
        <field name="name">adk.equipment.list</field>
        <field name="model">adk.equipment</field>
        <field name="arch" type="xml">
            <list string="Équipements" sample="1">
                <field name="name"/>
                <field name="code"/>
                <field name="site_ids" widget="many2many_tags"/>
                <field name="bloc_ids" widget="many2many_tags"/>
                <field name="purchase_date" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'good'"
                       decoration-danger="state == 'issue'"
                       decoration-warning="state == 'maintenance'"/>
            </list>
        </field>
    </record>

    <record id="view_adk_equipment_kanban" model="ir.ui.view">
        <field name="name">adk.equipment.kanban</field>
        <field name="model">adk.equipment</field>
        <field name="arch" type="xml">
            <kanban sample="1">
                <field name="name"/>
                <field name="code"/>
                <field name="site_ids"/>
                <field name="bloc_ids"/>
                <field name="state"/>
                <field name="image_1920"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click p-2">
                            <div class="d-flex">
                                <field name="image_1920" widget="image" class="o_kanban_image_fill_left rounded me-2"
                                       options="{'size': [40, 40], 'img_class': 'rounded'}" alt="Équipement"/>
                                <div class="flex-grow-1">
                                    <strong><field name="name"/></strong>
                                    <div class="text-muted small">
                                        <field name="site_ids" widget="many2many_tags"/>
                                        <t t-if="record.bloc_ids.raw_value.length"><field name="bloc_ids" widget="many2many_tags"/></t>
                                    </div>
                                </div>
                                <span class="badge"
                                      t-attf-class="badge #{record.state.raw_value == 'good' and 'text-bg-success' or record.state.raw_value == 'issue' and 'text-bg-danger' or 'text-bg-warning'}">
                                    <field name="state"/>
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_adk_equipment_form" model="ir.ui.view">
        <field name="name">adk.equipment.form</field>
        <field name="model">adk.equipment</field>
        <field name="arch" type="xml">
            <form string="Équipement">
                <sheet>
                    <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_1920'}"/>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_view_maintenances"
                                icon="fa-clipboard" invisible="not id">
                            <field name="maintenance_count" widget="statinfo" string="Interventions"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="En panne" bg_color="text-bg-danger" invisible="state != 'issue'"/>
                    <widget name="web_ribbon" title="En maintenance" bg_color="text-bg-warning" invisible="state != 'maintenance'"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nom de l'équipement"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="site_ids" widget="many2many_tags"/>
                            <field name="bloc_ids" widget="many2many_tags"
                                   domain="[('site_id', 'in', site_ids)]"/>
                            <field name="state" widget="radio" options="{'horizontal': true}"/>
                        </group>
                        <group>
                            <field name="purchase_date"/>
                            <field name="warranty_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Caractéristiques">
                            <field name="characteristic" placeholder="Caractéristiques techniques de l'équipement..."/>
                        </page>
                        <page string="Fiche technique">
                            <field name="technical_sheet" filename="technical_sheet_filename"/>
                            <field name="technical_sheet_filename" invisible="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_adk_equipment_search" model="ir.ui.view">
        <field name="name">adk.equipment.search</field>
        <field name="model">adk.equipment</field>
        <field name="arch" type="xml">
            <search string="Rechercher un équipement">
                <field name="name"/>
                <field name="code"/>
                <field name="site_ids"/>
                <field name="bloc_ids"/>
                <filter string="En panne" name="issue" domain="[('state', '=', 'issue')]"/>
                <filter string="En maintenance" name="maintenance" domain="[('state', '=', 'maintenance')]"/>
                <filter string="Bon fonctionnement" name="good" domain="[('state', '=', 'good')]"/>
                <group expand="0" string="Regrouper par">
                    <filter string="Point de contrôle" name="group_site" context="{'group_by': 'site_ids'}"/>
                    <filter string="Bloc" name="group_bloc" context="{'group_by': 'bloc_ids'}"/>
                    <filter string="État" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_adk_equipment" model="ir.actions.act_window">
        <field name="name">Équipements</field>
        <field name="res_model">adk.equipment</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_adk_equipment_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Enregistrez votre premier équipement</p>
            <p>Nom, caractéristiques, localisation, fiche technique, numéro...</p>
        </field>
    </record>

</odoo>
