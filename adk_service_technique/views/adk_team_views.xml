<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_adk_team_kanban" model="ir.ui.view">
        <field name="name">adk.team.kanban</field>
        <field name="model">adk.team</field>
        <field name="arch" type="xml">
            <kanban sample="1">
                <field name="name"/>
                <field name="agent_count"/>
                <field name="intervention_count"/>
                <field name="success_rate"/>
                <field name="avg_duration"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click p-2">
                            <strong class="o_kanban_record_title"><field name="name"/></strong>
                            <div class="text-muted">
                                <i class="fa fa-users me-1"/><t t-esc="record.agent_count.raw_value"/> agent(s)
                            </div>
                            <div class="mt-2">
                                <div class="d-flex justify-content-between small text-muted">
                                    <span>Taux de résolution</span>
                                    <span><t t-esc="record.success_rate.raw_value"/>%</span>
                                </div>
                                <div class="progress" style="height: 6px;">
                                    <div class="progress-bar bg-success" role="progressbar"
                                         t-attf-style="width: #{record.success_rate.raw_value}%"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_adk_team_list" model="ir.ui.view">
        <field name="name">adk.team.list</field>
        <field name="model">adk.team</field>
        <field name="arch" type="xml">
            <list string="Équipes de maintenance" sample="1">
                <field name="name"/>
                <field name="agent_count"/>
                <field name="intervention_count"/>
                <field name="open_intervention_count"/>
                <field name="avg_duration" widget="float_time"/>
                <field name="success_rate" widget="percentage"/>
            </list>
        </field>
    </record>

    <record id="view_adk_team_form" model="ir.ui.view">
        <field name="name">adk.team.form</field>
        <field name="model">adk.team</field>
        <field name="arch" type="xml">
            <form string="Équipe de maintenance">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_view_maintenances"
                                icon="fa-clipboard" invisible="not id">
                            <field name="intervention_count" widget="statinfo" string="Interventions"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Ex: Équipe de nuit"/></h1>
                    </div>
                    <group>
                        <field name="color" widget="color_picker"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active" invisible="1"/>
                    </group>
                    <group string="Statistiques" invisible="not id">
                        <field name="avg_duration" widget="float_time"/>
                        <field name="success_rate" widget="percentage"/>
                    </group>
                    <notebook>
                        <page string="Agents">
                            <field name="agent_ids" widget="many2many_tags"
                                   options="{'no_create': True}"
                                   placeholder="Sélectionner les employés Odoo concernés..."/>
                            <p class="text-muted mt-2">
                                Odoo propose déjà les employés/contacts présents dans le système.
                                Si un agent n'existe pas encore, contactez la RH pour qu'il crée le contact.
                            </p>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_adk_team_search" model="ir.ui.view">
        <field name="name">adk.team.search</field>
        <field name="model">adk.team</field>
        <field name="arch" type="xml">
            <search string="Rechercher une équipe">
                <field name="name"/>
                <field name="agent_ids"/>
            </search>
        </field>
    </record>

    <record id="action_adk_team" model="ir.actions.act_window">
        <field name="name">Équipes</field>
        <field name="res_model">adk.team</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_adk_team_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Créez votre première équipe</p>
            <p>Ex: Équipe de nuit, Équipe électricité... et renseignez les agents.</p>
        </field>
    </record>

</odoo>
