<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_intervention" model="ir.actions.report">
        <field name="name">Rapport de suivi d'intervention</field>
        <field name="model">adk.maintenance</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">adk_service_technique.report_intervention_template</field>
        <field name="report_file">adk_service_technique.report_intervention_template</field>
        <field name="binding_model_id" ref="model_adk_maintenance"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_intervention_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <t t-set="site" t-value="docs and docs[0].site_id"/>
                <div class="page">
                    <h2>Rapport de suivi d'intervention</h2>
                    <div class="row mb-3" t-if="site">
                        <div class="col-6">
                            <strong>Site :</strong> <span t-esc="site.name"/>
                        </div>
                    </div>
                    <table class="table table-sm table-bordered">
                        <thead>
                            <tr>
                                <th>Référence</th>
                                <th>Date constat</th>
                                <th>Site</th>
                                <th>Bloc</th>
                                <th>Équipement</th>
                                <th>Type</th>
                                <th>Équipe / Agents</th>
                                <th>Anomalie (diagnostic)</th>
                                <th>Solution (mesures / actions)</th>
                                <th>Statut</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="docs" t-as="doc">
                                <td><span t-field="doc.name"/></td>
                                <td><span t-field="doc.detection_date"/></td>
                                <td><span t-field="doc.site_id.name"/></td>
                                <td><span t-field="doc.bloc_id.name"/></td>
                                <td><span t-field="doc.equipment_id.name"/></td>
                                <td><span t-field="doc.maintenance_type_id.name"/></td>
                                <td>
                                    <span t-if="doc.team_id" t-field="doc.team_id.name"/>
                                    <span t-if="not doc.team_id" t-field="doc.agent_ids" widget="many2many_tags"/>
                                </td>
                                <td><span t-field="doc.diagnostic"/></td>
                                <td>
                                    <div><span t-field="doc.measures_taken"/></div>
                                    <div><span t-field="doc.corrective_actions"/></div>
                                </td>
                                <td><span t-field="doc.state"/></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
