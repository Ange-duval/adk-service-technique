<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_adk_report_wizard_form" model="ir.ui.view">
        <field name="name">adk.report.wizard.form</field>
        <field name="model">adk.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Générer un rapport">
                <group>
                    <field name="report_type" widget="radio"/>
                    <field name="site_id"/>
                    <field name="bloc_id" domain="[('site_id', '=', site_id)]"
                           placeholder="Laisser vide pour tout le site"/>
                    <field name="date_from" invisible="report_type != 'intervention'"/>
                    <field name="date_to" invisible="report_type != 'intervention'"/>
                </group>
                <footer>
                    <button name="action_generate_report" type="object" string="Générer le rapport"
                            class="btn-primary"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_adk_report_wizard" model="ir.actions.act_window">
        <field name="name">Générer un rapport</field>
        <field name="res_model">adk.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
